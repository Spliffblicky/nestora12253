# Copy this file to ".env" (same folder) and edit. Never commit ".env".

# --- Database (XAMPP defaults) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=realestate_app
DB_USER=root
DB_PASS=

# --- App ---
APP_NAME=Your App Name
APP_ENV=local                 # local = show error details; production = hide them
# Origins allowed to call the API, comma separated. Cordova uses http://localhost or file://
CORS_ORIGINS=*
PUBLIC_BASE_URL=http://localhost/Nestora/backend/public

# --- Email (verification codes, notices) ---
# MAIL_DRIVER: log (writes to storage/logs/mail.log, for local testing) or smtp
MAIL_DRIVER=log
MAIL_FROM=ebmanagement5666@gmail.com
MAIL_FROM_NAME=Nestora
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=ebmanagement5666@gmail.com
SMTP_PASS=lxfn rfhw cwyp zkzh
SMTP_SECURE=tls               # tls (STARTTLS, port 587) or ssl (port 465)

# --- SMS (phone verification, only used at payment steps) ---
# SMS_DRIVER: log (writes to storage/logs/sms.log, for local testing) or arkesel
SMS_DRIVER=log
SMS_SENDER_ID=YourApp         # your registered sender ID (the "default title")
ARKESEL_API_KEY=
ARKESEL_URL=https://sms.arkesel.com/api/v2/sms/send

# --- Seed file: passwords for seeded admins are read from here, not typed into seed files ---
SEED_ROOT_PASSWORD=
SEED_ADMIN2_PASSWORD=
